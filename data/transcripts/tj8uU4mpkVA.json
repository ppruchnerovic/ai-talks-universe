{"video_id":"tj8uU4mpkVA","title":"Lightning Talk: From AI Risk to Governance with NIST RMF","conference":"sans-ai-summit","language":"en","auto_generated":true,"source":"supa","timing":"exact","word_count":492,"segments":[{"start":2.0,"duration":3.92,"text":"Good afternoon everyone. My name is"},{"start":3.68,"duration":3.84,"text":"Kellb Charles"},{"start":5.92,"duration":3.76,"text":"and"},{"start":7.52,"duration":4.16,"text":"I'd like to begin with three quick"},{"start":9.68,"duration":5.92,"text":"questions."},{"start":11.68,"duration":8.08,"text":"The first one is how many organizations"},{"start":15.6,"duration":8.0,"text":"do you think are using AI today in some"},{"start":19.76,"duration":6.8,"text":"form whether it's generative AI or"},{"start":23.6,"duration":5.36,"text":"predictive analytics?"},{"start":26.56,"duration":4.24,"text":"Question number two, how many"},{"start":28.96,"duration":4.24,"text":"organizations do you think truly"},{"start":30.8,"duration":4.88,"text":"understands the risks behind those"},{"start":33.2,"duration":5.04,"text":"systems?"},{"start":35.68,"duration":5.68,"text":"And question number three,"},{"start":38.24,"duration":6.16,"text":"how many organizations do you think have"},{"start":41.36,"duration":5.52,"text":"a structured governance framework to"},{"start":44.4,"duration":5.2,"text":"help them identify and manage those"},{"start":46.88,"duration":4.56,"text":"risks?"},{"start":49.6,"duration":4.56,"text":"In my experience working in cyber"},{"start":51.44,"duration":6.08,"text":"security, the answer to those questions"},{"start":54.16,"duration":6.56,"text":"often revealed the gap. A gap that"},{"start":57.52,"duration":4.72,"text":"organizations are adopting AI"},{"start":60.72,"duration":4.32,"text":"quickly"},{"start":62.24,"duration":7.04,"text":"but compliance, risk management and"},{"start":65.04,"duration":7.04,"text":"security practices have yet to catch up."},{"start":69.28,"duration":7.56,"text":"So this brings us to the problem."},{"start":72.08,"duration":4.76,"text":"Organizations are adopting AI systems"},{"start":77.68,"duration":4.32,"text":"but are not understanding the true"},{"start":80.08,"duration":4.8,"text":"implications."},{"start":82.0,"duration":6.88,"text":"And some of these systems influence"},{"start":84.88,"duration":7.04,"text":"hiring decisions, financial outcomes,"},{"start":88.88,"duration":5.44,"text":"health care recommendations, and even"},{"start":91.92,"duration":5.44,"text":"security operations."},{"start":94.32,"duration":6.08,"text":"But organizations lack visibility into"},{"start":97.36,"duration":7.12,"text":"what AI systems they're using, how they"},{"start":100.4,"duration":7.52,"text":"are trained, what data they rely on, as"},{"start":104.48,"duration":6.68,"text":"well as what risks they introduce into"},{"start":107.92,"duration":3.24,"text":"the environment."},{"start":111.36,"duration":5.44,"text":"Without governance,"},{"start":113.44,"duration":5.92,"text":"organizations face multiple risks. Some"},{"start":116.8,"duration":4.56,"text":"of these risks includes bias and"},{"start":119.36,"duration":4.32,"text":"discrimination,"},{"start":121.36,"duration":4.96,"text":"privacy violation,"},{"start":123.68,"duration":4.48,"text":"intellectual property concerns,"},{"start":126.32,"duration":4.4,"text":"model manipulation, and even"},{"start":128.16,"duration":4.08,"text":"misinformation."},{"start":130.72,"duration":4.48,"text":"So, one of the things that we do"},{"start":132.24,"duration":5.04,"text":"understand is that AI is powerful,"},{"start":135.2,"duration":5.12,"text":"but AI"},{"start":137.28,"duration":5.04,"text":"without governance creates risks and"},{"start":140.32,"duration":4.4,"text":"uncertainty that most organizations"},{"start":142.32,"duration":5.28,"text":"can't afford to take."},{"start":144.72,"duration":4.56,"text":"So this brings us to our solution. How"},{"start":147.6,"duration":4.0,"text":"do we mitigate the problem that I just"},{"start":149.28,"duration":4.24,"text":"described?"},{"start":151.6,"duration":5.12,"text":"One of the most important frameworks"},{"start":153.52,"duration":5.92,"text":"available to us today is the NIS AI risk"},{"start":156.72,"duration":5.28,"text":"management framework."},{"start":159.44,"duration":5.44,"text":"It provides organizations"},{"start":162.0,"duration":6.08,"text":"with a practical solution for"},{"start":164.88,"duration":5.52,"text":"identifying, assessing and managing AI"},{"start":168.08,"duration":5.52,"text":"risks."},{"start":170.4,"duration":6.64,"text":"The four core functions consist of"},{"start":173.6,"duration":6.4,"text":"govern. This is where"},{"start":177.04,"duration":5.92,"text":"uh the foundation where organizations"},{"start":180.0,"duration":4.88,"text":"ensure accountability policies and"},{"start":182.96,"duration":5.2,"text":"oversight."},{"start":184.88,"duration":7.28,"text":"We also have map. This is about"},{"start":188.16,"duration":7.6,"text":"visibility where organizations document"},{"start":192.16,"duration":6.48,"text":"AI systems that they're using."},{"start":195.76,"duration":6.16,"text":"We have measure. measure is where"},{"start":198.64,"duration":7.12,"text":"organizations evaluate and assess AI"},{"start":201.92,"duration":7.28,"text":"risk such as bias, model manipulation,"},{"start":205.76,"duration":7.12,"text":"and even potential societal impact."},{"start":209.2,"duration":5.36,"text":"And finally, we have manage. Manage is"},{"start":212.88,"duration":5.6,"text":"where the action occurs, where the"},{"start":214.56,"duration":7.52,"text":"activity occurs, where organizations"},{"start":218.48,"duration":6.32,"text":"uh implement solutions and controls to"},{"start":222.08,"duration":5.04,"text":"reduce AI"},{"start":224.8,"duration":5.28,"text":"risk."},{"start":227.12,"duration":4.72,"text":"So now that I've discussed the problem"},{"start":230.08,"duration":5.6,"text":"and the solution, where do we go from"},{"start":231.84,"duration":5.84,"text":"here? As Daniel stated,"},{"start":235.68,"duration":4.0,"text":"AI assessment inventory is very"},{"start":237.68,"duration":6.08,"text":"important."},{"start":239.68,"duration":7.12,"text":"From here a AI impact assessment as well"},{"start":243.76,"duration":4.88,"text":"as security and AI red teaming needs to"},{"start":246.8,"duration":3.36,"text":"occur"},{"start":248.64,"duration":5.52,"text":"and"},{"start":250.16,"duration":8.76,"text":"continuous monitoring because AI"},{"start":254.16,"duration":4.76,"text":"evolve as data changes."},{"start":259.12,"duration":7.6,"text":"Governance is not a one-time activity."},{"start":262.96,"duration":6.0,"text":"It is an ongoing process"},{"start":266.72,"duration":4.4,"text":"and"},{"start":268.96,"duration":5.92,"text":"organizations"},{"start":271.12,"duration":7.52,"text":"who adopt AI the fastest does not always"},{"start":274.88,"duration":7.04,"text":"mean success. Organizations that adopt"},{"start":278.64,"duration":5.44,"text":"AI responsibly is what we're looking"},{"start":281.92,"duration":5.6,"text":"for."},{"start":284.08,"duration":6.4,"text":"AI governance is not about slowing down"},{"start":287.52,"duration":6.16,"text":"innovation. It's about enabling"},{"start":290.48,"duration":6.72,"text":"trustworthy innovation. And ultimately"},{"start":293.68,"duration":5.6,"text":"that is the goal that we're looking for."},{"start":297.2,"duration":5.36,"text":"So again"},{"start":299.28,"duration":7.04,"text":"AI governance"},{"start":302.56,"duration":9.0,"text":"is where we needs need to head as part"},{"start":306.32,"duration":5.24,"text":"of this whole process. Thank you."}]}